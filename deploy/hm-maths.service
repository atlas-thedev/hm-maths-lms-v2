[Unit]
Description=HM Maths LMS (Next.js)
After=network.target postgresql.service hm-postgrest.service
Wants=hm-postgrest.service

[Service]
User=hm
WorkingDirectory=/srv/hm-maths/app
EnvironmentFile=/srv/hm-maths/.env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/npx next start -p 3000 -H 127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
